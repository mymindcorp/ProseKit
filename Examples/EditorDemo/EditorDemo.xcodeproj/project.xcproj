  ],
  "targets": [
    {
      "name": "EditorDemo",
      "id": "29841B21F49CDD237BE9E85D",
      "product": "Products/EditorDemo.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "EditorMath",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "EditorSerialization",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "EditorSyntax",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "EditorUIKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SchemaKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGNING_ALLOWED": "NO",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "ai.processor.EditorDemo",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "YES",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,6",
      },
    }, {
      "name": "EditorInteractionTests",
      "id": "9BB21B87730A84D5673B02C9",
      "product": "Products/EditorInteractionTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "EditorDemo",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "EditorUIKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SchemaKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGNING_ALLOWED": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "ai.processor.EditorInteractionTests",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/EditorDemo.app/EditorDemo",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
